{
  "name": "@nampu/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/ensure-web-dist.mjs && wrangler dev --env dev",
    "deploy": "node ../../scripts/ensure-web-dist.mjs && wrangler deploy",
    "build": "node ../../scripts/ensure-web-dist.mjs && wrangler deploy --dry-run --outdir dist",
    "typecheck": "wrangler types --check && tsc -p .",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply nampu --local",
    "db:migrate:remote": "wrangler d1 migrations apply nampu --remote",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "@nampu/types": "workspace:*",
    "@noble/curves": "^2.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "drizzle-kit": "^0.31.11",
    "light-bolt11-decoder": "^3.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.138.0"
  }
}
