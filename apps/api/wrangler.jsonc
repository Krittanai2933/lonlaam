{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nampu",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  // No nodejs_compat: the bundle must stay Workers-native.

  // One Worker serves the SPA (apps/web/dist) and the API.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // These paths go to the Worker first; everything else is served straight from
    // static assets (no Worker invocation, no CPU cost).
    "run_worker_first": ["/api/*", "/p/*", "/media/*"]
  },

  // Production hosts. Everything but PUBLIC_ORIGIN (www, the loalaam.com typo domain,
  // workers.dev) redirects there (src/lib/canonical.ts).
  // Keep workers.dev up (it only redirects) so links shared before the domain still work.
  "workers_dev": true,
  "routes": [
    { "pattern": "lonlaam.com", "custom_domain": true },
    { "pattern": "www.lonlaam.com", "custom_domain": true },
    { "pattern": "loalaam.com", "custom_domain": true },
    { "pattern": "www.loalaam.com", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nampu",
      // Production database (wrangler d1 create nampu). --env dev keeps a local-only placeholder id.
      "database_id": "36e4219a-9909-469f-bb78-5d388b015bdd",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      // Create with: wrangler r2 bucket create nampu-media
      "bucket_name": "nampu-media"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "PROJECT_ROOM", "class_name": "ProjectRoom" }]
  },
  "migrations": [
    // SQLite-backed Durable Objects are the only kind available on the Free plan.
    { "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }
  ],

  "ratelimits": [
    // Workers Rate Limiting (Free plan). Keys are per client IP or per creator; period 10 or 60s.
    // namespace_id must be unique per account — change them if another Worker already uses these.
    { "name": "RL_INVOICE", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_POLL", "namespace_id": "4103", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "4104", "simple": { "limit": 30, "period": 60 } }
  ],

  "vars": {
    // Canonical origin: OG tags, cover URLs, Nostr/LNURL auth, and the redirect target for
    // every other host. Empty = use the request origin (local dev).
    "PUBLIC_ORIGIN": "https://lonlaam.com",
    // Public domain of the nampu-media R2 bucket: cover/story image URLs point here directly
    // (no Worker request per image). Empty = serve through this Worker's /media route.
    "MEDIA_ORIGIN": "https://media.lonlaam.com",
    "SITE_NAME": "ล้นหลาม",
    // "true" only for local dev: allows http:// LNURL endpoints and host:port Lightning Addresses.
    "ALLOW_INSECURE_LNURL": "false"
  },

  "observability": { "enabled": true },

  "env": {
    // wrangler dev --env dev (also used by the local smoke test)
    "dev": {
      "vars": { "PUBLIC_ORIGIN": "", "MEDIA_ORIGIN": "", "SITE_NAME": "ล้นหลาม (dev)", "ALLOW_INSECURE_LNURL": "true" },
      // No production routes locally: wrangler dev would rewrite request.url to lonlaam.com,
      // breaking the Nostr relay / LNURL host checks against localhost.
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nampu",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nampu-media" }],
      "durable_objects": {
        "bindings": [{ "name": "PROJECT_ROOM", "class_name": "ProjectRoom" }]
      },
      // Local limits: generous where smoke/e2e/seed scripts create lots of data from one IP;
      // RL_WRITE keeps the production value so the smoke test can exercise a real 429.
      "ratelimits": [
        { "name": "RL_INVOICE", "namespace_id": "4101", "simple": { "limit": 1000, "period": 60 } },
        { "name": "RL_AUTH", "namespace_id": "4102", "simple": { "limit": 1000, "period": 60 } },
        { "name": "RL_POLL", "namespace_id": "4103", "simple": { "limit": 1000, "period": 60 } },
        { "name": "RL_WRITE", "namespace_id": "4104", "simple": { "limit": 30, "period": 60 } }
      ]
    }
  }
}
