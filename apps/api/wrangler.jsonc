{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nampu",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  // No nodejs_compat: the bundle must stay Workers-native.

  // One Worker serves the SPA (apps/web/dist) and the API.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Page requests go to the Worker first so the canonical-host redirect also covers
    // "/" and SPA routes on www./loalaam.com/workers.dev (static assets skip the Worker
    // otherwise). Hashed bundles and icons are still served straight from assets
    // (no Worker invocation, no CPU cost); the Worker falls back to ASSETS for the rest.
    "run_worker_first": ["/*", "!/assets/*", "!/favicon*", "!/apple-touch-icon.png"]
  },

  // Production hosts. Everything but PUBLIC_ORIGIN (www, the loalaam.com typo domain,
  // workers.dev) redirects there (src/lib/canonical.ts).
  // Keep workers.dev up (it only redirects) so links shared before the domain still work.
  "workers_dev": true,
  "routes": [
    { "pattern": "lonlaam.com", "custom_domain": true },
    { "pattern": "www.lonlaam.com", "custom_domain": true },
    { "pattern": "loalaam.com", "custom_domain": true },
    { "pattern": "www.loalaam.com", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nampu",
      // Production database (wrangler d1 create nampu). --env dev keeps a local-only placeholder id.
      "database_id": "36e4219a-9909-469f-bb78-5d388b015bdd",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      // Create with: wrangler r2 bucket create nampu-media
      "bucket_name": "nampu-media"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_ROOM", "class_name": "ProjectRoom" },
      { "name": "SPRINKLE_ROOM", "class_name": "SprinkleRoom" },
      { "name": "PROJECT_TRANSLATOR", "class_name": "ProjectTranslator" },
      { "name": "MONTHLY_ROOM", "class_name": "MonthlyRoom" }
    ]
  },
  "migrations": [
    // SQLite-backed Durable Objects are the only kind available on the Free plan.
    { "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["SprinkleRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["ProjectTranslator"] },
    { "tag": "v4", "new_sqlite_classes": ["MonthlyRoom"] }
  ],

  // Starts monthly sprinkles that are due (src/lib/monthly.ts runMonthly). One of the 5 cron
  // triggers the Free plan allows.
  "triggers": { "crons": ["*/15 * * * *"] },

  "ratelimits": [
    // Workers Rate Limiting (Free plan). Keys are per client IP or per creator; period 10 or 60s.
    // namespace_id must be unique per account — change them if another Worker already uses these.
    { "name": "RL_INVOICE", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_POLL", "namespace_id": "4103", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "4104", "simple": { "limit": 30, "period": 60 } }
  ],

  "vars": {
    // Canonical origin: OG tags, cover URLs, Nostr/LNURL auth, and the redirect target for
    // every other host. Empty = use the request origin (local dev).
    "PUBLIC_ORIGIN": "https://lonlaam.com",
    // Public domain of the nampu-media R2 bucket: cover/story image URLs point here directly
    // (no Worker request per image). Empty = serve through this Worker's /media route.
    "MEDIA_ORIGIN": "https://media.lonlaam.com",
    "SITE_NAME": "ล้นหลาม",
    // "true" only for local dev: allows http:// LNURL endpoints and host:port Lightning Addresses.
    "ALLOW_INSECURE_LNURL": "false",
    // Sender for monthly-sprinkle emails (Resend; the domain must be verified there). Email is
    // off until the secret RESEND_API_KEY is set.
    "EMAIL_FROM": "ล้นหลาม <noreply@lonlaam.com>",
    // Lightning Address that receives the share supporters leave for Lonlaam on monthly sprinkles
    // (forwarded from the platform wallet after the projects are paid). Empty = keep it there.
    "PLATFORM_ADDRESS": "krittanai@peanjaroen.com"
    // Secret NWC_ENC_KEY (64 hex chars, e.g. `openssl rand -hex 32`) encrypts supporters' NWC
    // connection strings and turns on automatic monthly payment. Never change it once set:
    // stored connections would stop opening and those supporters fall back to paying by hand.
    // Secret ANTHROPIC_API_KEY (wrangler secret put ANTHROPIC_API_KEY) turns on English
    // machine translation of project text (src/do/project-translator.ts). Unset = off.
  },

  "observability": { "enabled": true },

  "env": {
    // wrangler dev --env dev (also used by the local smoke test)
    "dev": {
      "vars": {
        "PUBLIC_ORIGIN": "",
        "MEDIA_ORIGIN": "",
        "SITE_NAME": "ล้นหลาม (dev)",
        "ALLOW_INSECURE_LNURL": "true",
        "EMAIL_FROM": "ล้นหลาม (dev) <dev@localhost>",
        "PLATFORM_ADDRESS": "lonlaam@localhost:8790",
        // Fixed dev-only key. Email goes to the mock wallet (GET :8790/email/last) instead of Resend.
        "NWC_ENC_KEY": "6e616d70752d6465762d6f6e6c792d6e77632d656e632d6b65792d3030303030",
        "RESEND_API_KEY": "mock",
        "RESEND_API_URL": "http://localhost:8790/email",
        // Sprinkle wallet = the mock NWC relay in scripts/mock-wallet.mjs (fixed test keys).
        // Production sets it as a secret: wrangler secret put NWC_URL
        "NWC_URL": "nostr+walletconnect://ebdda12636f35f00fe588fbcf77fa6f763ea4a88eaa1fcd6d51fc31d4fd334d5?relay=ws://localhost:8791&secret=a5dc994f93583db22acc96d86081ae48061d293f0aafd12d3692c5ab5aa5b3ad"
      },
      // No production routes locally: wrangler dev would rewrite request.url to lonlaam.com,
      // breaking the Nostr relay / LNURL host checks against localhost.
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nampu",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nampu-media" }],
      "durable_objects": {
        "bindings": [
          { "name": "PROJECT_ROOM", "class_name": "ProjectRoom" },
          { "name": "SPRINKLE_ROOM", "class_name": "SprinkleRoom" },
          { "name": "PROJECT_TRANSLATOR", "class_name": "ProjectTranslator" },
          { "name": "MONTHLY_ROOM", "class_name": "MonthlyRoom" }
        ]
      },
      // Local limits: generous where smoke/e2e/seed scripts create lots of data from one IP;
      // RL_WRITE keeps the production value so the smoke test can exercise a real 429.
      "ratelimits": [
        { "name": "RL_INVOICE", "namespace_id": "4101", "simple": { "limit": 1000, "period": 60 } },
        { "name": "RL_AUTH", "namespace_id": "4102", "simple": { "limit": 1000, "period": 60 } },
        { "name": "RL_POLL", "namespace_id": "4103", "simple": { "limit": 1000, "period": 60 } },
        { "name": "RL_WRITE", "namespace_id": "4104", "simple": { "limit": 30, "period": 60 } }
      ]
    }
  }
}
